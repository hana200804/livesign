# Sao chép thành .env rồi điền giá trị thật. File .env không được commit.
MAPILLARY_TOKEN=
VIETMAP_API_KEY=
MYSQL_URL=jdbc:mysql://localhost:3306/livesign
MYSQL_USER=livesign
MYSQL_PASSWORD=
MYSQL_DATABASE=livesign
MYSQL_ROOT_PASSWORD=
MYSQL_PORT=3306
# PAT chỉ đọc repo; ưu tiên lưu trong Colab Secrets, không ghi vào notebook.
GITHUB_TOKEN=
# URL thư mục Drive nhóm (điền sau khi cả ba người đã kiểm tra quyền).
SHARED_DRIVE_URL=
# Công cụ gán nhãn hiện có đọc PORT, mặc định 8787.
PORT=8787
# Backend: khóa ký JWT HS256, tối thiểu 32 byte, mỗi máy tự sinh.
LIVESIGN_JWT_SECRET=
# Backend: thư mục gốc kho ảnh và manifest (ngoài git).
LIVESIGN_DATA_ROOT=
# Backend: cổng HTTP của Spring, mặc định 8080. Không dùng PORT ở trên.
LIVESIGN_HTTP_PORT=8080
# Android: base URL của backend, ghi vào android/local.properties.
LIVESIGN_API_BASE_URL=
