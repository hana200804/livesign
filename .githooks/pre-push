#!/usr/bin/env bash
# Không push thẳng lên main: mọi thay đổi vào main đi qua Pull Request.
# Vẫn kiểm tra lại bí mật trên các commit sắp push (phòng commit tạo trước khi bật hook).
set -euo pipefail
root=$(git rev-parse --show-toplevel)
zero=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # xóa nhánh trên remote
  if [ "$remote_ref" = refs/heads/main ] && [ "${ALLOW_PUSH_MAIN:-}" != 1 ]; then
    echo "✗ Không push thẳng lên main. Tạo nhánh rồi mở Pull Request:" >&2
    echo "    git switch -c <phần>/<mô tả>   &&   git push" >&2
    exit 1
  fi
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
  fi
  "$root/.githooks/check.sh" range "$base" "$local_sha"
done
